{
  "name": "volcancito-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "node scripts/sync-app.mjs",
    "check": "astro check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run check && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
