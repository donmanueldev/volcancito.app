---
interface Props {
  face?: boolean;
  sleeping?: boolean;
  hat?: boolean;
}

const { face = false, sleeping = false, hat = false } = Astro.props;
const ink = 'var(--color-ink)';
const MOUNTAIN =
  'M40 30 Q42 26 46 26 L58 26 Q62 26 64 30 Q70 60 84 76 Q94 86 98 90 Q100 94 95 94 L9 94 Q4 94 6 90 Q10 86 20 76 Q34 60 40 30 Z';
const LAVA =
  'M38 36 Q38 28 46 28 L58 28 Q66 28 66 36 L70 52 L64 47 L59 54 L53 46 L47 53 L41 47 L35 51 Z';
const STRAW = '#EAC37E';
const BLUSH = '#E3A08A';
---

<g stroke-linejoin="round" stroke-linecap="round">
  <rect x="8" y="93" width="92" height="4" rx="2" fill={ink}></rect>
  <path d={MOUNTAIN} fill="var(--color-green)" stroke={ink} stroke-width="3.2"></path>
  <path d={LAVA} fill="var(--color-yellow)" stroke={ink} stroke-width="3"></path>
  {
    face && (
      <g>
        <path d="M30 80 Q40 52 45 42" fill="none" stroke="#5CBF7A" stroke-width="3" />
        {sleeping ? (
          <path
            d="M41 66 Q45 69 49 66 M57 66 Q61 69 65 66 M49 75 Q53 78 57 75"
            fill="none"
            stroke={ink}
            stroke-width="2.4"
          />
        ) : (
          <g>
            <ellipse cx="45" cy="65" rx="3.6" ry="4.4" fill={ink} />
            <ellipse cx="61" cy="65" rx="3.6" ry="4.4" fill={ink} />
            <circle cx="46" cy="63.5" r="1.2" fill="#fff" />
            <circle cx="62" cy="63.5" r="1.2" fill="#fff" />
            <path
              d="M47 73 Q53 79 59 73 Z"
              fill="var(--color-coral)"
              stroke={ink}
              stroke-width="2"
            />
          </g>
        )}
        <ellipse cx="38" cy="72" rx="4.5" ry="2.8" fill={BLUSH} />
        <ellipse cx="68" cy="72" rx="4.5" ry="2.8" fill={BLUSH} />
      </g>
    )
  }
  {
    hat && (
      <g>
        <ellipse cx="53" cy="33" rx="26" ry="6" fill={STRAW} stroke={ink} stroke-width="2.6" />
        <path d="M39 32 Q39 14 53 14 Q67 14 67 32 Z" fill={STRAW} stroke={ink} stroke-width="2.6" />
        <rect
          x="39.5"
          y="25"
          width="27"
          height="6"
          fill="var(--color-coral)"
          stroke={ink}
          stroke-width="2"
        />
        <circle cx="31" cy="38" r="4.5" fill="#fff" stroke={ink} stroke-width="1.8" />
        <circle cx="31" cy="38" r="1.6" fill="var(--color-yellow)" />
      </g>
    )
  }
</g>
