---
import Logo from './Logo.astro';
import { nav } from '../lib/site';
---

<header class="relative z-10 flex items-stretch bg-paper text-ink">
  <div class="flex lg:w-[42%] lg:min-w-fit">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 bg-ink py-3 pr-5 pl-margin text-paper"
      aria-label="Volcancito, inicio"
    >
      <Logo size={40} showName={false} />
      <span class="font-school text-[1.75rem] leading-none font-bold">Volcancito</span>
    </a>
    <nav aria-label="Principal" class="hidden flex-1 items-center gap-1 bg-yellow px-3 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-3 py-2 font-semibold whitespace-nowrap transition-colors hover:bg-ink hover:text-yellow"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="ml-auto flex items-center py-2 pr-margin pl-3">
    <a href="/#vocales" class="btn btn-primary min-h-11 px-5">Pruébalo</a>
  </div>
</header>
