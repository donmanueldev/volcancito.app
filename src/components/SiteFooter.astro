---
import Logo from './Logo.astro';
import MomotomboMark from './MomotomboMark.astro';
import { site } from '../lib/site';

const links = [
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/terminos', label: 'Términos' },
  { href: '/ayuda', label: 'Ayuda' },
  { href: '/borrar-cuenta', label: 'Borrar cuenta' },
];
---

<footer class="mt-24 border-t-[3px] border-ink bg-sand">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-10 md:flex-row md:justify-between"
  >
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm">
      <span class="flex items-center gap-1.5 font-semibold">
        <Logo size={34} showName={false} />
        Volcancito
      </span>
      <a href={site.studio.url} class="flex items-center gap-1.5">
        <span class="font-medium text-muted">Hecho por</span>
        <MomotomboMark height={13} />
        <span class="font-semibold">{site.studio.name}</span>
      </a>
    </div>
    <nav
      aria-label="Legal"
      class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm font-semibold"
    >
      {
        links.map((link) => (
          <a href={link.href} class="underline-offset-4 hover:underline">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
