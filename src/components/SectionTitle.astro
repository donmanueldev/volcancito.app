---
interface Props {
  kicker?: string;
  title: string;
  id?: string;
  center?: boolean;
}

const { kicker, title, id, center = false } = Astro.props;
---

<div class:list={['mb-8 flex flex-col gap-2', center && 'items-center text-center']}>
  {kicker && <p class="text-sm font-semibold text-muted">{kicker}</p>}
  <h2 id={id} class="text-3xl leading-tight font-bold text-balance md:text-4xl">{title}</h2>
  <slot />
</div>
