---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, caption, eager = false, class: className } = Astro.props;
---

<figure class:list={['flex flex-col items-center gap-4', className]}>
  <div class="w-full rounded-[2.4rem] bg-ink p-2.5">
    <Image
      src={src}
      alt={alt}
      widths={[280, 560, 720]}
      sizes="(min-width: 1024px) 17rem, 70vw"
      class="block h-auto w-full rounded-[1.9rem]"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  {caption && <figcaption class="text-center text-body font-semibold">{caption}</figcaption>}
</figure>
