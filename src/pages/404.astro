---
import Mascot from '../components/Mascot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="mx-auto flex max-w-xl flex-col items-center gap-6 px-5 pt-12 text-center">
    <Mascot size={180} sleeping />
    <h1 class="text-4xl font-bold">Esta página se quedó dormida</h1>
    <p class="text-lg font-medium text-muted">No encontramos lo que buscabas.</p>
    <a href="/" class="btn btn-primary">Volver al inicio</a>
  </section>
</BaseLayout>
