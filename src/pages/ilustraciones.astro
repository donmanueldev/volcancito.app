---
import Art from '../components/Art.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { artIds, artLabel } from '../lib/art';
---

<BaseLayout
  title="Ilustraciones"
  description="Las ilustraciones de Volcancito: animales, comidas, objetos y lugares de Nicaragua dibujados para la app."
>
  <section class="mx-auto max-w-6xl px-5 pt-6">
    <h1 class="text-4xl font-bold md:text-5xl">Ilustraciones</h1>
    <p class="mt-3 max-w-2xl text-lg font-medium text-muted">
      Las {artIds.length} figuras que acompañan cada letra, palabra y ficha de Nicaragua. Son las mismas
      de la app, dibujadas con trazo grueso para que se lean bien en pantallas pequeñas.
    </p>
    <ul class="mt-10 grid grid-cols-3 gap-4 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
      {
        artIds.map((id) => (
          <li class="flex flex-col items-center gap-1 rounded-app-sm bg-white p-2 pb-3 hard-shadow-sm ink-border">
            <div class="w-full rounded-xl bg-sand">
              <Art id={id} size={100} class="h-auto w-full" />
            </div>
            <span class="text-center text-xs font-semibold">{artLabel(id)}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
