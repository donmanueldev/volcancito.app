---
import PhoneFrame from '../components/PhoneFrame.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { screens } from '../lib/screens';
---

<BaseLayout
  title="Pantallas"
  description="Así se ve Volcancito por dentro: vocales, juegos, trazos, oraciones y Nicaragua."
>
  <section class="mx-auto max-w-6xl px-5 pt-6">
    <h1 class="text-4xl font-bold md:text-5xl">Pantallas</h1>
    <p class="mt-3 max-w-2xl text-lg font-medium text-muted">
      Capturas reales de la app en un teléfono Android. Todo lo que ves está pensado para manos
      pequeñas: botones grandes, dibujos con voz y rondas cortas.
    </p>
    <ul class="mt-12 grid justify-items-center gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        screens.map((screen, i) => (
          <li>
            <PhoneFrame
              src={screen.src}
              alt={screen.alt}
              caption={screen.caption}
              tilt={i % 2 ? 1.5 : -1.5}
              eager={i < 3}
            />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
