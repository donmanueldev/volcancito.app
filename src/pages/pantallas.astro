---
import PhoneFrame from '../components/PhoneFrame.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { screens } from '../lib/screens';
---

<BaseLayout
  title="Pantallas"
  description="Así se ve Volcancito por dentro: vocales, juegos, trazos, oraciones y Nicaragua."
>
  <section class="frame pt-16 pb-8 lg:pt-24">
    <div class="grid gap-6 lg:grid-cols-12">
      <h1 class="text-display font-bold lg:col-span-7">Pantallas</h1>
      <p class="max-w-[38ch] self-end text-lead font-medium lg:col-span-5">
        Capturas reales de la app en un teléfono Android. Botones grandes, dibujos con voz y rondas
        cortas, pensados para manos pequeñas.
      </p>
    </div>
    <ul class="mt-16 flex flex-wrap justify-center gap-x-10 gap-y-16 lg:mt-24">
      {
        screens.map((screen, i) => (
          <li class="w-[min(17rem,78vw)]">
            <PhoneFrame src={screen.src} alt={screen.alt} caption={screen.caption} eager={i < 4} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
